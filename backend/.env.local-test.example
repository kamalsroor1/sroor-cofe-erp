# =============================================================================
# Sroor ERP - LOCAL multi-tenant test environment (Laragon on Windows)
# Guide: docs/07-operations/local-testing.md
#
# scripts/local/setup-local.ps1 merges these keys into backend/.env after backing it
# up to backend/.env.backup-<timestamp>. Merge rules:
#   - APP_KEY is never touched.
#   - Secret keys (*PASSWORD*, *SECRET*, *TOKEN*, *_KEY*, *DSN*) keep any non-empty value
#     already in .env; the empty values below are placeholders only.
#   - Every other key below overwrites the .env value (they define this topology).
#   - Keys missing from .env are appended at the end.
#
# LOCAL ONLY. Never copy this file to a server. No real secret belongs in this file.
# =============================================================================

APP_ENV=local
APP_DEBUG=true
# Its scheme (http here) is the scheme of every tenant/console URL the app builds
# (workspace resolver server_url, impersonation exit); production is always https.
APP_URL=http://sroor.test

# --- Database (Laragon MySQL 8.4). NEW databases only, all prefixed sroor_local_ ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sroor_local_central
# Laragon default: root without password. setup-local.ps1 detects it; when your root has
# a password the script asks for it (hidden) and writes it to .env only.
DB_USERNAME=root
DB_PASSWORD=
# One database per tenant: <prefix><tenant id>, e.g. sroor_local_tenant_demo.
# Restore drills use <prefix>zz_restore_* (config/backup.php), so they stay in the prefix.
TENANT_DB_PREFIX=sroor_local_tenant_
# Tenant-context jobs and Pulse rows must land in the CENTRAL DB (the worker reads there).
# Without these, a job dispatched inside a tenant request is written to the tenant DB's
# own jobs table and never runs.
DB_QUEUE_CONNECTION=mysql
PULSE_DB_CONNECTION=mysql

# --- Hosts (see scripts/local/hosts-entries.txt) ---
# Tenant subdomains are <slug>.CENTRAL_DOMAIN (config tenancy.central_domain, App\Support\PlatformHosts).
CENTRAL_DOMAIN=sroor.test
# Platform console host: /super-admin/* and /api/v1/super-admin/* answer ONLY here.
CENTRAL_ADMIN_DOMAINS=admin.sroor.test
CENTRAL_PASSWORD_RESET_URL=http://admin.sroor.test/super-admin/reset-password

# --- Sessions / cookies ---
# Host-only cookies on purpose (SESSION_DOMAIN=null): a ".sroor.test" cookie would be
# shared by demo.sroor.test, shop2.sroor.test and admin.sroor.test, which is not how
# tenant isolation works in production. The API uses Bearer tokens, not cookies.
SESSION_DRIVER=file
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=sroor.test,admin.sroor.test,demo.sroor.test,shop2.sroor.test,localhost,127.0.0.1

# --- Cache / queue (staging-like: no Redis) ---
# File cache: the database store would follow the tenant connection inside tenant requests.
CACHE_STORE=file
QUEUE_CONNECTION=database

# --- Mail: everything goes to storage/logs/laravel.log ---
# To use Laragon's Mailpit instead (UI http://localhost:8025), set:
#   MAIL_MAILER=smtp  MAIL_HOST=127.0.0.1  MAIL_PORT=1025  MAIL_SCHEME=null
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@sroor.test
MAIL_FROM_NAME="Sroor ERP (local)"

# --- Testing aids (LOCAL ONLY; refused outside APP_ENV=local/testing) ---
QUICK_LOGIN_ENABLED=true
TELESCOPE_ENABLED=true
PULSE_ENABLED=true

# --- Logs ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# --- Backups to the local disk only (storage/app/<BACKUP_PATH_PREFIX>) ---
BACKUP_DISKS=local
BACKUP_PATH_PREFIX=sroor-local-backups
# Set a local throw-away password to test encrypted archives; empty = unencrypted + warning.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=ops@sroor.test

# --- External services stay OFF locally ---
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_SCHEDULED_JOBS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
SENTRY_LARAVEL_DSN=
