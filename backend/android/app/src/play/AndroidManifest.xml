<?xml version="1.0" encoding="utf-8"?>
<!--
  MOB-03: "play" flavor (Google Play). Play policy forbids self-updating with a downloaded APK:
  no AppUpdater plugin, and REQUEST_INSTALL_PACKAGES is stripped even if a library merges it in.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
</manifest>
