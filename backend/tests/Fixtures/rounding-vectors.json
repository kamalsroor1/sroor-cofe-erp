{
    "description": "SETG-13 shared rounding vectors. Rule: scale 3, half-up (a tie rounds away from zero); operands are settled at scale 3 first, the operation is exact, the result is rounded once. Run by tests/Unit/Money/RoundingParityTest.php (app/Support/Money/Decimal.php) and tests/js/decimal-rounding.test.js (resources/js/helpers/decimal.js). Ops: normalize(a), add(a,b), sub(a,b), mul(a,b), percent(amount,pct), cmp(a,b).",
    "vectors": [
        { "op": "normalize", "args": ["12"], "expected": "12.000" },
        { "op": "normalize", "args": [".5"], "expected": "0.500" },
        { "op": "normalize", "args": ["7."], "expected": "7.000" },
        { "op": "normalize", "args": ["+2"], "expected": "2.000" },
        { "op": "normalize", "args": ["1.23456"], "expected": "1.235" },
        { "op": "normalize", "args": ["-1.23456"], "expected": "-1.235" },
        { "op": "normalize", "args": ["1.2345"], "expected": "1.235" },
        { "op": "normalize", "args": ["-1.2345"], "expected": "-1.235" },
        { "op": "normalize", "args": ["1.2344999"], "expected": "1.234" },
        { "op": "normalize", "args": ["0.0005"], "expected": "0.001" },
        { "op": "normalize", "args": ["-0.0005"], "expected": "-0.001" },
        { "op": "normalize", "args": ["0.0004999"], "expected": "0.000" },
        { "op": "normalize", "args": ["-0.0004"], "expected": "0.000" },
        { "op": "normalize", "args": ["0.9995"], "expected": "1.000" },
        { "op": "normalize", "args": ["-0.9995"], "expected": "-1.000" },
        { "op": "normalize", "args": ["999999999.9995"], "expected": "1000000000.000" },
        { "op": "normalize", "args": ["1e-4"], "expected": "0.000" },
        { "op": "normalize", "args": ["5e-4"], "expected": "0.001" },
        { "op": "normalize", "args": ["1.5e3"], "expected": "1500.000" },
        { "op": "normalize", "args": ["-0"], "expected": "0.000" },
        { "op": "normalize", "args": [""], "expected": "0.000" },
        { "op": "normalize", "args": ["abc"], "expected": "0.000" },

        { "op": "add", "args": ["0.1", "0.2"], "expected": "0.300" },
        { "op": "add", "args": ["0.0005", "0.0005"], "expected": "0.002" },
        { "op": "add", "args": ["-1.5", "0.25"], "expected": "-1.250" },
        { "op": "sub", "args": ["1", "1.5"], "expected": "-0.500" },
        { "op": "sub", "args": ["0.0004", "0.0005"], "expected": "-0.001" },
        { "op": "sub", "args": ["1200", "1100.000"], "expected": "100.000" },

        { "op": "mul", "args": ["0.250", "550.500"], "expected": "137.625" },
        { "op": "mul", "args": ["1.375", "3.333"], "expected": "4.583" },
        { "op": "mul", "args": ["-1.375", "3.333"], "expected": "-4.583" },
        { "op": "mul", "args": ["1.375", "-3.333"], "expected": "-4.583" },
        { "op": "mul", "args": ["0.333", "0.333"], "expected": "0.111" },
        { "op": "mul", "args": ["0.255", "12.345"], "expected": "3.148" },
        { "op": "mul", "args": ["0.5", "0.001"], "expected": "0.001" },
        { "op": "mul", "args": ["-0.5", "0.001"], "expected": "-0.001" },
        { "op": "mul", "args": ["0.4", "0.001"], "expected": "0.000" },
        { "op": "mul", "args": ["-0.4", "0.001"], "expected": "0.000" },
        { "op": "mul", "args": ["1.0005", "2"], "expected": "2.002" },
        { "op": "mul", "args": ["3", "0.1665"], "expected": "0.501" },
        { "op": "mul", "args": ["2.5", "4"], "expected": "10.000" },

        { "op": "percent", "args": ["137.625", "12.5"], "expected": "17.203" },
        { "op": "percent", "args": ["1000", "10"], "expected": "100.000" },
        { "op": "percent", "args": ["99.999", "33.333"], "expected": "33.333" },
        { "op": "percent", "args": ["0.010", "5"], "expected": "0.001" },
        { "op": "percent", "args": ["-0.010", "5"], "expected": "-0.001" },
        { "op": "percent", "args": ["10.005", "50"], "expected": "5.003" },
        { "op": "percent", "args": ["0.009", "5"], "expected": "0.000" },

        { "op": "cmp", "args": ["1.000", "1"], "expected": 0 },
        { "op": "cmp", "args": ["0.9995", "1"], "expected": 0 },
        { "op": "cmp", "args": ["0.9994", "1"], "expected": -1 },
        { "op": "cmp", "args": ["10", "9.999"], "expected": 1 },
        { "op": "cmp", "args": ["-0.0005", "0"], "expected": -1 }
    ]
}
