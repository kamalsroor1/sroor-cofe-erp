APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Platform root domain: tenants live on <slug>.<CENTRAL_DOMAIN>. Empty = baraa-solutions.com.
# Local testing: sroor.test (see docs/07-operations/local-testing.md).
CENTRAL_DOMAIN=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Africa/Cairo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# IDEN-1.15 audit retention prune account. Leave commented to fall back to the DB_* account
# (an empty value would override that fallback). Required in production (sroor_audit_pruner).
# DB_AUDIT_PRUNER_USERNAME=
# DB_AUDIT_PRUNER_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Passwordless quick login: honoured only when APP_ENV is local or testing. Empty = off.
# Setting it to true with APP_ENV=production makes the app refuse to serve HTTP at boot.
QUICK_LOGIN_ENABLED=
# Quick-login token lifetime in minutes. Empty = 480 (8 hours).
QUICK_LOGIN_TOKEN_TTL=
# Tenant API token lifetime in minutes, renewed on use. Empty = 43200 (30 days).
TENANT_TOKEN_TTL_MINUTES=
# Platform operator (central) API token lifetime in minutes. Empty = 240 (4 hours).
CENTRAL_TOKEN_TTL_MINUTES=
# Host(s) of the super-admin console, comma-separated (e.g. admin.example.com).
# Empty: production 404s every super-admin route; local/testing fall back to the central domains.
CENTRAL_ADMIN_DOMAINS=
# https:// console page that consumes central password-reset tokens; its host must be one of
# CENTRAL_ADMIN_DOMAINS (e.g. https://admin.example.com/super-admin/reset-password). Empty = no reset mail is sent.
CENTRAL_PASSWORD_RESET_URL=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=true
# Central scheduled Telegram jobs (notify:*). Keep false until they are tenant-aware (OPS-10).
TELEGRAM_SCHEDULED_JOBS_ENABLED=false

# public/update_webhook.php: HMAC-SHA256 secret (min 32 chars). Empty = webhook refuses every request.
DEPLOY_WEBHOOK_HMAC_SECRET=

# SaaS billing numbering (config/billing.php). Prefix: letters/digits only, never the brand name.
BILLING_TIMEZONE=Africa/Cairo
BILLING_INVOICE_PREFIX=SUB
# yearly = counter restarts every year (INV-2026-000001), none = one continuous counter
BILLING_INVOICE_NUMBER_PERIOD=yearly
BILLING_INVOICE_NUMBER_PAD=5

VITE_APP_NAME="${APP_NAME}"

# PKG-1 packages. Sentry (Q-O2): empty DSN = disabled; never send PII (pinned in config/sentry.php).
SENTRY_LARAVEL_DSN=
# Horizon is installed but only runs where QUEUE_CONNECTION=redis (production VPS); Hostinger/dev keep the database queue.

# OPS-5 backups (docs/07-operations/backup-restore.md). `php artisan backup:tenants` writes one
# AES-256 archive per database. Empty password: refused unless APP_ENV is local or testing (D4),
# where the archives are left unencrypted. Failure mails carry subject + exception class only.
BACKUP_ARCHIVE_PASSWORD=
# Comma separated disks: local (dev/staging) or google (VPS).
BACKUP_DISKS=local
BACKUP_PATH_PREFIX=sroor-backups
# Failure alerts address. Leave commented to fall back to MAIL_FROM_ADDRESS.
# BACKUP_NOTIFICATION_EMAIL=
# Read-only mysqldump account (sroor_backup on the VPS). Empty = the DB_* account.
DB_BACKUP_USERNAME=
DB_BACKUP_PASSWORD=
# Google Drive OAuth (owner's account, one-time consent). Never commit real values.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
# Restore drill account (CREATE on the restore prefix). Empty = the DB_* account.
DB_RESTORE_USERNAME=
DB_RESTORE_PASSWORD=
# OPS-2 tenant provisioner (CREATE/DROP DATABASE + per-tenant users; sroor_provisioner on the VPS,
# never root). Empty = the DB_* account. MySQL/MariaDB only.
DB_PROVISIONER_USERNAME=
DB_PROVISIONER_PASSWORD=
# One MySQL user per tenant, granted on its own database only (required where DB_USERNAME has no
# access to tenant databases, e.g. the VPS). Off = tenants connect with the DB_* account.
TENANT_DB_PER_TENANT_USER=false
# Host part of the per-tenant users (empty = localhost).
TENANT_DB_USER_HOST=
# Queue for ProvisionTenantJob (empty = default connection / "default" queue). The connection's
# retry_after must exceed the job timeout (900 s). Use "sync" to provision inline (local scripts).
TENANT_PROVISIONING_QUEUE_CONNECTION=
TENANT_PROVISIONING_QUEUE=
# retry_after of the `provisioning` queue connection (seconds, never below 960). Empty = 1000.
TENANT_PROVISIONING_RETRY_AFTER=
# Unique-lock window of ProvisionTenantJob (seconds, never below 2850). Empty = 3600. A pending/running
# tenant idle for longer may be retried from the console (lost dispatch / dead worker).
TENANT_PROVISIONING_UNIQUE_FOR=
# OPS-7 health checks: alerts address (commented = BACKUP_NOTIFICATION_EMAIL); Horizon check on the VPS only.
# HEALTH_TO_ADDRESS=
HEALTH_CHECK_HORIZON=false

# Telescope: in APP_ENV=local the dashboard still requires a central super admin unless this is
# explicitly true (single-developer machines only). Never set it on a shared or public host.
TELESCOPE_LOCAL_OPEN=
