APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Africa/Cairo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Passwordless quick login: honoured only when APP_ENV is local or testing. Empty = off.
# Setting it to true with APP_ENV=production makes the app refuse to serve HTTP at boot.
QUICK_LOGIN_ENABLED=
# Quick-login token lifetime in minutes. Empty = 480 (8 hours).
QUICK_LOGIN_TOKEN_TTL=
# Tenant API token lifetime in minutes, renewed on use. Empty = 43200 (30 days).
TENANT_TOKEN_TTL_MINUTES=
# Platform operator (central) API token lifetime in minutes. Empty = 240 (4 hours).
CENTRAL_TOKEN_TTL_MINUTES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=true
# Central scheduled Telegram jobs (backup:telegram, notify:*). Keep false until they are tenant-aware.
TELEGRAM_SCHEDULED_JOBS_ENABLED=false

# public/update_webhook.php: HMAC-SHA256 secret (min 32 chars). Empty = webhook refuses every request.
DEPLOY_WEBHOOK_HMAC_SECRET=

# SaaS billing numbering (config/billing.php). Prefix: letters/digits only, never the brand name.
BILLING_TIMEZONE=Africa/Cairo
BILLING_INVOICE_PREFIX=INV
# yearly = counter restarts every year (INV-2026-000001), none = one continuous counter
BILLING_INVOICE_NUMBER_PERIOD=yearly
BILLING_INVOICE_NUMBER_PAD=6

VITE_APP_NAME="${APP_NAME}"

# PKG-1 packages. Sentry (Q-O2): empty DSN = disabled; never send PII (pinned in config/sentry.php).
SENTRY_LARAVEL_DSN=
# Horizon is installed but only runs where QUEUE_CONNECTION=redis (production VPS); Hostinger/dev keep the database queue.
