{
    "private": true,
    "type": "module",
    "scripts": {
        "lang:export": "php artisan lang:export",
        "prebuild": "php -d memory_limit=512M artisan lang:export",
        "build": "node --max-old-space-size=2048 ./node_modules/vite/bin/vite.js build",
        "dev": "vite",
        "lint": "eslint resources/js vite.config.js eslint.config.js scripts",
        "lint:fix": "eslint resources/js vite.config.js eslint.config.js scripts --fix",
        "lint:dirty": "node scripts/run-on-changed.mjs eslint",
        "format": "prettier --write resources/js vite.config.js eslint.config.js scripts",
        "format:check": "prettier --check resources/js vite.config.js eslint.config.js scripts",
        "format:dirty": "node scripts/run-on-changed.mjs prettier --write",
        "format:dirty:check": "node scripts/run-on-changed.mjs prettier --check",
        "cap:sync": "npx cap sync android",
        "cap:build": "vite build && npx cap sync android",
        "cap:open": "npx cap open android",
        "e2e:all": "npx playwright test --config=../playwright.config.js",
        "e2e:desktop": "npx playwright test --config=../playwright.config.js --project=desktop",
        "e2e:tablet": "npx playwright test --config=../playwright.config.js --project=tablet",
        "e2e:mobile": "npx playwright test --config=../playwright.config.js --project=mobile",
        "e2e:touch": "npx playwright test --config=../playwright.config.js --project=tablet --project=mobile",
        "e2e:module": "npx playwright test --config=../playwright.config.js --grep",
        "e2e:page": "npx playwright test --config=../playwright.config.js -g",
        "e2e:flow": "npx playwright test --config=../playwright.config.js e2e/flows/",
        "e2e:report": "npx playwright show-report"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0",
        "vue-eslint-parser": "^10.4.1"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.0",
        "@capacitor/app": "^8.1.1",
        "@capacitor/camera": "^8.2.3",
        "@capacitor/cli": "^8.5.0",
        "@capacitor/core": "^8.5.0",
        "@capacitor/haptics": "^8.0.2",
        "@capacitor/network": "^8.0.1",
        "@capacitor/status-bar": "^8.0.3",
        "@capacitor/toast": "^8.0.1",
        "@capgo/capacitor-native-biometric": "^8.6.7",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vuepic/vue-datepicker": "^14.0.0",
        "axios": "^1.19.0",
        "flatpickr": "^4.6.13",
        "lucide-vue-next": "^1.0.0",
        "pinia": "^3.0.4",
        "sweetalert2": "^11.26.25",
        "vue": "^3.5.41",
        "vue-router": "^4.6.4"
    }
}
