{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "cap:sync": "npx cap sync android",
        "cap:build": "vite build && npx cap sync android",
        "cap:open": "npx cap open android",
        "e2e:all": "npx playwright test --config=../playwright.config.js",
        "e2e:desktop": "npx playwright test --config=../playwright.config.js --project=desktop",
        "e2e:tablet": "npx playwright test --config=../playwright.config.js --project=tablet",
        "e2e:mobile": "npx playwright test --config=../playwright.config.js --project=mobile",
        "e2e:touch": "npx playwright test --config=../playwright.config.js --project=tablet --project=mobile",
        "e2e:module": "npx playwright test --config=../playwright.config.js --grep",
        "e2e:page": "npx playwright test --config=../playwright.config.js -g",
        "e2e:flow": "npx playwright test --config=../playwright.config.js e2e/flows/",
        "e2e:report": "npx playwright show-report"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.0",
        "@capacitor/camera": "^8.2.3",
        "@capacitor/cli": "^8.5.0",
        "@capacitor/core": "^8.5.0",
        "@capacitor/haptics": "^8.0.2",
        "@capacitor/network": "^8.0.1",
        "@capacitor/status-bar": "^8.0.3",
        "@capacitor/toast": "^8.0.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vuepic/vue-datepicker": "^14.0.0",
        "axios": "^1.19.0",
        "flatpickr": "^4.6.13",
        "lucide-vue-next": "^1.0.0",
        "pinia": "^3.0.4",
        "sweetalert2": "^11.26.25",
        "vue": "^3.5.41",
        "vue-router": "^4.6.4"
    }
}
