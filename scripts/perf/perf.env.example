# PERF-04 load test configuration. Copy to scripts/perf/perf.env (git-ignored) and fill in.
# LOCAL servers only: the script refuses any host other than localhost / 127.0.0.1 /
# *.localhost / *.test, with no override. Never put production tokens here.

# Base URL of the local server (php artisan serve / docker).
PERF_BASE_URL=http://127.0.0.1:8000

# Tenant ids, space-separated. The FIRST one is the big tenant the read scenarios run on.
PERF_TENANTS="perf1 perf2 perf3"

# One Sanctum token per tenant, same order (see docs/07-operations/perf-testing.md for how
# to mint throwaway tokens on a local tenant).
PERF_TOKENS=""

# How the script calls artisan for the consistency check (same database as the server).
# PERF_ARTISAN="php /path/to/backend/artisan"

# Concurrent users of the dashboard scenario, request count in percent of the defaults, and the sold quantity
# per sale (a weighted item is used, so a fraction keeps the stock positive).
# PERF_USERS=20
# PERF_PERCENT=100
# PERF_SALE_QTY=0.050

# Where ab output and per-request times are written (default: a new temp directory).
# PERF_OUT=/tmp/sroor-perf
