# VPS provisioning settings for scripts/ops/provision.sh (OPS-1).
#
# Copy to the SERVER as /root/sroor-provision.env, then:  chmod 600 /root/sroor-provision.env
# Never commit the filled-in copy. Never paste the values into chat, docs or tickets.
# Secrets must be FRESH (never reuse anything from git history or the old server).
# Generate each secret on the server without printing it, e.g.:
#   sed -i "s/^MYSQL_APP_PASSWORD=.*/MYSQL_APP_PASSWORD=$(openssl rand -hex 32)/" /root/sroor-provision.env
# Secrets must be 24+ characters of [A-Za-z0-9] (hex output qualifies).

# ---- Platform -------------------------------------------------------------
# Platform domain (apex). The wildcard *.<domain> covers every shop subdomain
# and the super-admin host (admin.<domain>). Example: example.com
PLATFORM_DOMAIN=
TIMEZONE=UTC
SWAP_SIZE_GB=4

# ---- Accounts and SSH -----------------------------------------------------
# Human admin with sudo (key login only). Public key file must exist on the server.
ADMIN_USER=opsadmin
ADMIN_SSH_PUBKEY_FILE=/root/keys/admin.pub
# Service account: owns the code, runs php-fpm, Horizon and the scheduler.
# CI deploys (OPS-3) log in as this user with a dedicated deploy key.
APP_USER=sroor
DEPLOY_SSH_PUBKEY_FILE=/root/keys/deploy.pub
SSH_PORT=22

# ---- Application layout ---------------------------------------------------
APP_ROOT=/var/www/sroor
# PHP 8.4 from the ondrej/php PPA (step 30), see vps-runbook.md §4.3.
PHP_VERSION=8.4
PHP_FPM_MAX_CHILDREN=20
# HSTS max-age in seconds (includeSubDomains is NOT sent: other subdomains of
# the platform domain may not be HTTPS yet).
HSTS_MAX_AGE=31536000

# ---- MySQL 8.4 LTS (repo.mysql.com, step 40) --------------------------------
CENTRAL_DB_NAME=sroor_central
# Must equal TENANT_DB_PREFIX in the app .env (config/tenancy.php).
TENANT_DB_PREFIX=tenant_
# 'localhost' = unix socket. The app .env must use DB_HOST=localhost.
MYSQL_USER_HOST=localhost
MYSQL_INNODB_BUFFER_POOL=2G
MYSQL_APP_USER=sroor_app
MYSQL_APP_PASSWORD=
MYSQL_MIGRATOR_USER=sroor_migrator
MYSQL_MIGRATOR_PASSWORD=
MYSQL_PROVISIONER_USER=sroor_provisioner
MYSQL_PROVISIONER_PASSWORD=
MYSQL_BACKUP_USER=sroor_backup
MYSQL_BACKUP_PASSWORD=
# Retention prune of the audit tables only (IDEN-1.15). Laravel connection
# `audit_pruner` reads DB_AUDIT_PRUNER_USERNAME / DB_AUDIT_PRUNER_PASSWORD.
MYSQL_AUDIT_PRUNER_USER=sroor_audit_pruner
MYSQL_AUDIT_PRUNER_PASSWORD=
# Append-only central tables: the app account gets no UPDATE/DELETE on them.
CENTRAL_AUDIT_TABLES="central_audit_logs activity_log"
# Append-only financial ledgers (ENTI-1.10): no UPDATE/DELETE for app, never pruned.
CENTRAL_APPEND_ONLY_TABLES="tenant_credit_ledger"

# ---- Redis ------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_MAXMEMORY=1gb

# ---- TLS: wildcard certificate via DNS-01 ----------------------------------
CERTBOT_EMAIL=
# One of: cloudflare, digitalocean, linode, ovh, rfc2136
# TODO(CTO): confirm the DNS provider of the platform domain.
CERTBOT_DNS_PLUGIN=cloudflare
# certbot DNS plugin credentials (API token scoped to DNS edit of this zone
# only). Create it on the server, chmod 600, never in the repo.
CERTBOT_DNS_CREDENTIALS_FILE=/root/.secrets/certbot-dns.ini
CERTBOT_DNS_PROPAGATION_SECONDS=60
# 1 = Let's Encrypt staging (use for rehearsals to avoid rate limits).
CERTBOT_STAGING=0

# ---- Queue ------------------------------------------------------------------
# horizon (default, needs laravel/horizon from PKG-1) or worker (plain queue:work).
QUEUE_MODE=horizon
QUEUE_WORKER_PROCESSES=2
