# Managed by scripts/ops (OPS-1). The app/deploy account may only reload
# php-fpm (opcache reset after a release switch) and inspect/restart its own
# supervisor programs. Nothing else.
${APP_USER} ALL=(root) NOPASSWD: /usr/bin/systemctl reload php${PHP_VERSION}-fpm
${APP_USER} ALL=(root) NOPASSWD: /usr/bin/supervisorctl status
${APP_USER} ALL=(root) NOPASSWD: /usr/bin/supervisorctl restart sroor-horizon
${APP_USER} ALL=(root) NOPASSWD: /usr/bin/supervisorctl restart sroor-worker\:\*
