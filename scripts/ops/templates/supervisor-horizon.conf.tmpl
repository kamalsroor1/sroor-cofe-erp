; Managed by scripts/ops (OPS-1). Horizon supervises the Redis queue workers.
; A release switch runs `php artisan horizon:terminate`; supervisor then
; restarts Horizon from the new `current` release.
[program:sroor-horizon]
command=/usr/bin/php ${APP_ROOT}/current/backend/artisan horizon
directory=${APP_ROOT}/current/backend
user=${APP_USER}
autostart=true
autorestart=true
startsecs=5
stopasgroup=true
killasgroup=true
stopsignal=TERM
stopwaitsecs=3600
redirect_stderr=true
stdout_logfile=${APP_ROOT}/shared/storage/logs/horizon.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=5
