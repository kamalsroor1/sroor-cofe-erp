# Deploy-only credentials (OPS-3). Rendered by the release workflow from the
# GitHub Environment `production` and uploaded next to the artifact; deploy.sh
# deletes it when the run ends. It is NEVER part of the app .env, so the
# runtime (php-fpm, Horizon, scheduler) never holds DDL rights.
# Validate:  bash scripts/ops/render-env.sh scripts/ops/templates/deploy.env.example OUT

# Central schema migrations + per-table grant sync (GRANT OPTION on central).
DB_MIGRATOR_USERNAME=sroor_migrator
DB_MIGRATOR_PASSWORD=
