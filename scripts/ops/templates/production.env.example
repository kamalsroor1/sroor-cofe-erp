# Production .env skeleton for the VPS (OPS-1). Keys + safe defaults only.
# The real file lives at ${APP_ROOT}/shared/.env (owner = app user, chmod 600)
# and is filled from GitHub Environment secrets (OPS-4). Never commit it.
# Validate before every release:  bash scripts/ops/check-env.sh <file>

APP_NAME="Retail ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Central / platform hosts (IDEN-1.11). All three are REQUIRED (render-env.sh +
# check-env.sh) and come from GitHub Environment variables (vars.*), not secrets.
# CENTRAL_DOMAIN: platform root domain, tenants live on <slug>.<CENTRAL_DOMAIN>
#   (bare host, e.g. example.com). Empty would fall back to a hardcoded domain.
# CENTRAL_ADMIN_DOMAINS: comma-separated host(s) of the super-admin console
#   (e.g. admin.example.com). Empty = every super-admin route 404s in production.
# CENTRAL_PASSWORD_RESET_URL: https:// page of the console that consumes the
#   reset token; its host must be one of CENTRAL_ADMIN_DOMAINS
#   (e.g. https://admin.example.com/super-admin/reset-password).
#   Empty = central password-reset mails are never sent.
CENTRAL_DOMAIN=
CENTRAL_ADMIN_DOMAINS=
CENTRAL_PASSWORD_RESET_URL=

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Central DB. DB_USERNAME is the DML-only `app` account (vps-runbook.md §5).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sroor_central
DB_USERNAME=sroor_app
DB_PASSWORD=
TENANT_DB_PREFIX=tenant_
# Audit retention prune only (IDEN-1.15, Laravel connection `audit_pruner`):
# SELECT + DELETE on the audit tables, nothing else (vps-runbook.md §5.1).
DB_AUDIT_PRUNER_USERNAME=sroor_audit_pruner
DB_AUDIT_PRUNER_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Production standards: Telescope off, quick-login off (boot fails if on).
TELESCOPE_ENABLED=false
QUICK_LOGIN_ENABLED=false
PULSE_ENABLED=true
TENANT_TOKEN_TTL_MINUTES=43200

SANCTUM_STATEFUL_DOMAINS=

# Mandatory SMTP (W1 Q6): Brevo or Amazon SES SMTP. Every MAIL_* key below is
# required by render-env.sh and check-env.sh; the release fails without them.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Backup archive encryption (OPS-5, CTO decision D4): empty = backups refuse to
# run, the deploy preflight fails and the health check is red.
BACKUP_ARCHIVE_PASSWORD=
# Backups (OPS-5, docs/07-operations/backup-restore.md): archives go to Google
# Drive (OAuth of the owner's account, refresh token from a one-time consent).
# Dumps run with the read-only `sroor_backup` MySQL account (vps-runbook.md §5).
BACKUP_DISKS=google
BACKUP_PATH_PREFIX=sroor-backups
BACKUP_NOTIFICATION_EMAIL=
DB_BACKUP_USERNAME=sroor_backup
DB_BACKUP_PASSWORD=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Empty = the app creates BACKUP_PATH_PREFIX in My Drive itself (works with the
# least-privilege drive.file scope). release.yml passes it as --optional.
GOOGLE_DRIVE_FOLDER_ID=
# Health (OPS-7): Horizon runs on the VPS. Alerts go to BACKUP_NOTIFICATION_EMAIL.
HEALTH_CHECK_HORIZON=true

# Sentry (OPS-7): the DSN lives ONLY in this VPS .env (via the GitHub
# Environment secret). Empty = reporting off (check-env.sh warns). No PII.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_SCHEDULED_JOBS_ENABLED=false
