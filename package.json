{
  "name": "erp-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --prefix-colors \"bgBlue.bold,bgGreen.bold,bgMagenta.bold\" --names \"SERVER,FRONTEND,MOBILE\" \"npm:serve:backend\" \"npm:dev:backend\" \"npm:dev:mobile\"",
    "serve:backend": "php backend/artisan serve --host=0.0.0.0 --port=8000",
    "dev:backend": "npm --prefix backend run dev",
    "dev:mobile": "npm --prefix mobile run dev",
    "build": "concurrently \"npm:build:backend\" \"npm:build:mobile\"",
    "build:backend": "npm --prefix backend run build",
    "build:mobile": "npm --prefix mobile run build",
    "test:fresh": "playwright test tests/e2e/specs/unified_fresh_journey.spec.js --headed --project=Mobile-Pixel-7",
    "test:journey": "playwright test tests/e2e/specs/unified_journey.spec.js --headed --project=Mobile-Pixel-7",
    "test:e2e": "playwright test",
    "test:watch": "playwright test --headed --project=Mobile-Pixel-7",
    "test:ui": "playwright test --ui",
    "test:auth": "playwright test tests/e2e/specs/01_auth_session.spec.js --headed --project=Mobile-Pixel-7",
    "test:stores": "playwright test tests/e2e/specs/02_store_switching.spec.js --headed --project=Mobile-Pixel-7",
    "test:shifts": "playwright test tests/e2e/specs/03_shifts_cash.spec.js --headed --project=Mobile-Pixel-7",
    "test:pos": "playwright test tests/e2e/specs/04_pos_fast_checkout.spec.js --headed --project=Mobile-Pixel-7",
    "test:invoices": "playwright test tests/e2e/specs/05_invoices_lifecycle.spec.js --headed --project=Mobile-Pixel-7",
    "test:report": "playwright show-report tests/e2e/reports",
    "e2e:all": "playwright test",
    "e2e:desktop": "playwright test --project=desktop",
    "e2e:tablet": "playwright test --project=tablet",
    "e2e:mobile": "playwright test --project=mobile",
    "e2e:touch": "playwright test --project=tablet --project=mobile",
    "e2e:module": "playwright test --grep",
    "e2e:page": "playwright test -g",
    "e2e:flow": "playwright test e2e/flows/",
    "e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.1.2",
    "puppeteer": "^25.7.0"
  }
}
