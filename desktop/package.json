{
  "name": "sroor-cofe-erp-desktop",
  "version": "1.0.0",
  "description": "نظام سرور كوفي ERP & POS - تطبيق سطح المكتب لنقاط البيع وإدارة المؤسسات",
  "main": "main.js",
  "author": "Baraa Solutions <info@baraa-solutions.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/**/*.test.js\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "lint": "eslint main.js preload.js src test eslint.config.mjs",
    "lint:fix": "eslint main.js preload.js src test eslint.config.mjs --fix",
    "lint:dirty": "node ../backend/scripts/run-on-changed.mjs eslint",
    "format": "prettier --write main.js preload.js src test eslint.config.mjs",
    "format:check": "prettier --check main.js preload.js src test eslint.config.mjs",
    "format:dirty": "node ../backend/scripts/run-on-changed.mjs prettier --write",
    "format:dirty:check": "node ../backend/scripts/run-on-changed.mjs prettier --check"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "build": {
    "appId": "com.baraasolutions.sroorerp",
    "productName": "سرور كوفي ERP & POS",
    "copyright": "Copyright © 2026 Baraa Solutions",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Sroor-ERP-POS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "سرور كوفي ERP",
      "uninstallDisplayName": "سرور كوفي ERP & POS"
    }
  }
}
